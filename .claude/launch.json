{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "co-admin-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001
    },
    {
      "name": "co-admin-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && PORT=5000 npm run start:dev"],
      "port": 5000
    },
    {
      "name": "co-admin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3001
    }
  ]
}
