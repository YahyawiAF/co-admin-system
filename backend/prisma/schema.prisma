enum Subscription {
  Journal
  Membership
}

enum AdvisorReportStatus {
  PENDING
  DONE
  FAILED
}

/// AI business report: the data sent to Claude and its recommendations
model AdvisorReport {
  id           String              @id @default(uuid())
  facilityId   String
  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  status       AdvisorReportStatus @default(PENDING)
  /// MANUAL or WEEKLY
  trigger      String              @default("MANUAL")
  periodFrom   DateTime
  periodTo     DateTime
  snapshot     Json
  result       Json?
  error        String?
  model        String
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([facilityId, createdAt])
  @@map("advisor_reports")
}

/// A business change the owner started (e.g. "selling coffee"), tracked before/after
model BusinessInitiative {
  id             String    @id @default(uuid())
  facilityId     String
  facility       Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  /// NEW_REVENUE, PROMO, PRICING, CAFE, RETENTION, OPERATIONS
  category       String    @default("NEW_REVENUE")
  startDate      DateTime
  endDate        DateTime?
  sourceReportId String?
  /// Title of the advice this action answers (links advice → follow-up)
  recommendationTitle String?
  /// Figure to watch: revenuePerDay, visitsPerDay, revenueCafe, cafeAttachRatePct, avgStayHours, newMembers, revenueSubscriptions, avgOccupancyPct
  metric         String?
  /// Expected change of the metric, in % (e.g. 20 = +20 %)
  targetPct      Float?
  /// What the action cost (DT): material, discounts, ads…
  cost           Float?
  /// Owner's own conclusion: WORKING | MIXED | NOT_WORKING
  ownerVerdict   String?
  /// What happened, written by the owner: [{ date: "yyyy-MM-dd", text }]
  notes          Json      @default("[]")
  /// Who the action aims at — only that is measured: ALL | SLOT (days + hours) | LIST (clients)
  targetKind     String    @default("ALL")
  /// SLOT: 0 = Sunday … 6 = Saturday; empty = every day
  targetDays     Int[]     @default([])
  /// SLOT: hours [from, to); to ≤ from wraps past midnight; null = all day
  targetFromHour Int?
  targetToHour   Int?
  /// LIST: the list chosen (campaign segment code) and its clients, frozen at start
  targetSegment  String?
  targetMemberIds String[] @default([])
  /// Sale tied to the action, counted directly: PRICE (service / offer) | PRODUCT | PROMOTION | EVENT
  linkedKind     String?
  linkedId       String?
  /// TICKETS | SUBSCRIBERS | CAFE | QUIET_HOURS | OTHER
  objective      String?
  /// Why it should work, one line
  hypothesis     String?
  /// INSTAGRAM_POST | INSTAGRAM_STORY | WHATSAPP | APP | PARTNER | WALK_IN
  channels       String[]  @default([])
  /// Planned steps: [{ text, done, doneAt?: "yyyy-MM-dd" }]
  steps          Json      @default("[]")
  /// Figures typed from Instagram: [{ date: "yyyy-MM-dd", channel?, reach }]
  manualFunnel   Json      @default("[]")
  shareLinks     ShareLink[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([facilityId, startDate])
  @@map("business_initiatives")
}

/// A tracked link shared on one channel; the app counts who opens it
model ShareLink {
  id           String              @id @default(uuid())
  code         String              @unique
  facilityId   String
  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  initiativeId String?
  initiative   BusinessInitiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  /// EVENT (only kind for now)
  kind         String              @default("EVENT")
  targetId     String
  /// Same codes as BusinessInitiative.channels
  channel      String
  opens        Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([initiativeId])
  @@map("share_links")
}

/// Context the AI cannot see in the figures: calendar, neighbourhood, clientele
model AdvisorFact {
  id            String    @id @default(uuid())
  facilityId    String
  facility      Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// HOLIDAY | PERIOD | LOCAL_EVENT | NEIGHBOR | AUDIENCE
  kind          String
  title         String
  detail        String?
  /// NEIGHBOR: restaurant, cafe, shop, dorm, university, school, competitor, office, other
  /// PERIOD: ramadan, exams, vacation, other
  tag           String?
  startDate     DateTime?
  endDate       DateTime?
  distanceM     Int?
  /// AUDIENCE: member group used to measure this clientele
  memberGroupId String?
  /// MANUAL | PRESET | OSM
  source        String    @default("MANUAL")
  /// false = estimated (e.g. Aïd dates), the owner is asked to confirm
  confirmed     Boolean   @default(true)
  /// Dedupe key for presets and OpenStreetMap places
  externalId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([facilityId, externalId])
  @@index([facilityId, kind])
  @@map("advisor_facts")
}

/// Questions the AI asked in its reports, answered by the owner and fed back next time
model AdvisorQuestion {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  key        String
  question   String
  answer     String?
  /// OPEN | ANSWERED | DISMISSED
  status     String   @default("OPEN")
  reportId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([facilityId, key])
  @@map("advisor_questions")
}

/// Flash offer shown to members as a "golden card" popup; the discount applies automatically
model Promotion {
  id               String         @id @default(uuid())
  facilityId       String
  facility         Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  /// PRODUCT (café…) | PRICE (pass / tarif) | OTHER (free offer, reception applies it)
  target           String
  productId        String?
  product          Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceId          String?
  price            Price?         @relation(fields: [priceId], references: [id], onDelete: Cascade)
  valueKind        PromoValueKind @default(PERCENT)
  value            Float
  startsAt         DateTime
  endsAt           DateTime?
  /// 0 = Sunday … 6 = Saturday; empty = every day
  daysOfWeek       Int[]          @default([])
  /// Happy hour, e.g. 14 → 17; null = all day
  fromHour         Int?
  toHour           Int?
  /// ALL | IN_SESSION (only members currently on site)
  audience         String         @default("ALL")
  maxUsesPerMember Int?
  maxUses          Int?
  /// GOLD | VIOLET | GREEN
  style            String         @default("GOLD")
  isActive         Boolean        @default(true)
  views            Int            @default(0)
  clicks           Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  uses             PromotionUse[]

  @@index([facilityId, isActive])
  @@map("promotions")
}

model PromotionUse {
  id             String    @id @default(uuid())
  promotionId    String
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  memberId       String?
  dailyProductId String?
  journalId      String?
  /// Amount charged after the discount (DT)
  amount         Float
  /// Discount given (DT)
  discount       Float
  createdAt      DateTime  @default(now())

  @@index([promotionId, memberId])
  @@map("promotion_uses")
}

/// A saved relance: a frozen list of clients + a message, with progress tracking
model OutreachCampaign {
  id                  String   @id @default(uuid())
  facilityId          String
  facility            Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  title               String
  /// Template; {prenom} is replaced by each client's first name
  message             String
  /// ABO_EXPIRING | ABO_ENDED | INACTIVE | CONVERT | TOP_UP | UNPAID | RECENT_30 | ALL | GROUP
  segment             String
  memberGroupId       String?
  memberIds           String[] @default([])
  /// VISIT | SUBSCRIPTION | ANY — what counts as a result
  goal                String   @default("ANY")
  /// ACTIVE | DONE
  status              String   @default("ACTIVE")
  sourceReportId      String?
  recommendationTitle String?
  initiativeId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([facilityId, createdAt])
  @@map("outreach_campaigns")
}

/// Durable queue of entities that still need to be pushed to the ERP (supply-chain-pro).
/// Written synchronously by the owning service right after its own write; drained by SyncProcessorService.
model SyncOutbox {
  id         String   @id @default(uuid())
  /// member | price | abonnement | journal
  entityType String
  entityId   String
  /// CREATE | UPDATE
  operation  String
  /// PENDING | SYNCED | FAILED | SUPERSEDED (failed, but the entity synced later)
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, entityType, createdAt])
  @@map("sync_outbox")
}

/// Co-admin entity id ↔ supply-chain-pro entity id, one row per synced record.
model SyncMapping {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  externalId String
  syncedAt   DateTime @default(now())

  @@unique([entityType, entityId])
  @@map("sync_mappings")
}

enum StaffActionStatus {
  PENDING
  CONFIRMED
  REVERTED
}

/// Everything a STAFF user changed — the admin confirms or reverts each action.
model StaffAction {
  id             String            @id @default(uuid())
  createdAt      DateTime          @default(now())
  organizationId String?
  userId         String
  user           User              @relation("StaffActionActor", fields: [userId], references: [id], onDelete: Cascade)
  /// journal | reservations | impayes | abonnements
  module         String
  /// CREATE | UPDATE | DELETE | HIDE
  action         String
  /// journal | abonnement | memberLedger | seatBooking | bookingRequest | other
  entityType     String
  entityId       String?
  method         String
  path           String
  summary        String?
  before         Json?
  after          Json?
  status         StaffActionStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?             @relation("StaffActionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote     String?

  @@index([organizationId, status, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("staff_actions")
}

/// Conseiller: the owner's answers to the manager's questions (bank balance, charges, reserve…)
model BusinessAnswer {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// bank | safe | charges | payroll | taxes | promised | reserve
  key        String
  /// DT (reserve: months); null when the owner does not know
  value      Float?
  /// What the owner picked, e.g. "3 000 – 8 000 DT"
  label      String
  /// How the value was counted, e.g. "bas de la fourchette"
  note       String?
  unknown    Boolean  @default(false)
  answeredAt DateTime @default(now())
  answeredBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([facilityId, key])
  @@map("business_answers")
}

/// Conseiller: a tool the manager asks for; the owner approves before anything is built
model FeatureProposal {
  id            String    @id @default(uuid())
  facilityId    String
  facility      Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  key           String
  title         String
  /// SUGGESTED | APPROVED | TICKET_READY | DEFERRED | REJECTED
  stage         String    @default("SUGGESTED")
  deferredUntil DateTime?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([facilityId, key])
  @@map("feature_proposals")
}
