generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  isActive                Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt @db.Timestamp(6)
  deletedAt               DateTime?                @db.Timestamp(6)
  email                   String?                  @unique @db.VarChar(256)
  fullname                String?                  @db.VarChar(256)
  password                String?
  refreshToken            String?
  role                    Role                     @default(USER)
  resetPasswordToken      String?
  accessToken             String?
  phoneNumber             String?                  @unique
  Journals                Journal[]
  organizationMemberships OrganizationMembership[]
  facilityMemberships     FacilityMembership[]
  staffActions            StaffAction[]            @relation("StaffActionActor")
  reviewedStaffActions    StaffAction[]            @relation("StaffActionReviewer")

  @@map("users")
}

model Member {
  id                       String              @id @default(uuid())
  organizationId           String
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                    String?             @db.VarChar(256)
  firstName                String?             @db.VarChar(56)
  lastName                 String?             @db.VarChar(56)
  bio                      String?
  avatarUrl                String?
  credits                  Float               @default(0)
  plan                     Subscription?       @default(Journal)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt @db.Timestamp(6)
  deletedAt                DateTime?           @db.Timestamp(6)
  isActive                 Boolean             @default(false)
  functionality            String?
  phone                    String?             @db.VarChar(32)
  passwordHash             String?
  pinHash                  String?
  visitorNumber            Int?
  userId                   Int?
  groupId                  String?
  group                    MemberGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  discountForfait          Float?
  discountAbonnement       Float?
  discountSalle            Float?
  discountOpenSpace        Float?
  /// Last time the member used an app-install promo
  appInstallPromoClaimedAt DateTime?
  /// App-install promos already used: AppInstallPromo ids, or "global" (each is single-use)
  appInstallPromosUsed     String[]            @default([])
  /// First time the member opened the app as an installed PWA
  pwaInstalledAt           DateTime?
  /// Gamification score — only credited when client is installed PWA
  points                   Int                 @default(0)
  abonnements              Abonnement[]
  journals                 Journal[]
  reservations             Reservation[]
  seatBookings             SeatBooking[]
  visitRequests            VisitRequest[]
  productOrders            DailyProduct[]
  sentMessages             CommunityMessage[]  @relation("MessageFrom")
  receivedMessages         CommunityMessage[]  @relation("MessageTo")
  communityNotes           CommunityNote[]
  staffMessages            StaffMessage[]
  loginTokens              MemberLoginToken[]
  skills                   String[]            @default([])
  services                 String[]            @default([])
  linkedinUrl              String?
  openToCollaboration      Boolean             @default(true)
  showInDirectory          Boolean             @default(true)
  /// Community status while on site (null = not set)
  availability             MemberAvailability?
  /// "Recherche" tags: what the member is looking for
  lookingFor               String[]            @default([])
  /// "Focus du jour" — short status shown while on site (expires daily)
  todayFocus               String?             @db.VarChar(120)
  todayFocusAt             DateTime?
  /// Opt-in: show streak & level on the public profile
  shareAttendance          Boolean             @default(false)
  eventRegistrations       EventRegistration[]
  pushSubscriptions        PushSubscription[]
  ledgerEntries            MemberLedger[]
  bookingRequests          BookingRequest[]
  pointEntries             MemberPointEntry[]
  trophies                 MemberTrophy[]
  outreach                 MemberOutreach[]
  /// Code shared to invite friends (lazy-generated)
  referralCode             String?             @unique
  referredById             String?
  referredBy               Member?             @relation("MemberReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                Member[]            @relation("MemberReferral")
  /// Set once both sides got the referral points (first paid visit of the referred member)
  referralRewardedAt       DateTime?
  reviewPromptedAt         DateTime?
  reviewClickedAt          DateTime?

  @@unique([organizationId, phone])
  @@unique([organizationId, visitorNumber])
  @@index([organizationId])
  @@index([groupId])
  @@map("members")
}

enum MemberAvailability {
  OPEN_TO_CHAT
  FOCUS
}

enum PointEvent {
  CHECK_IN
  CHECK_OUT
  CAFE_ORDER
  INSTALL_PWA
  VISIT_PAID
  PRODUCT_PAID
  ADMIN_ADJUST
  REDEEM_VISIT
  REDEEM_ORDER
  PROFILE_DETAILS
  PROFILE_AVATAR
  REFERRAL
}

enum PointEntryStatus {
  PENDING
  CREDITED
  EXPIRED
}

/// Point awards: PENDING in browser (expire if never claimed via PWA), CREDITED in PWA
model MemberPointEntry {
  id         String           @id @default(uuid())
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount     Int
  event      PointEvent
  status     PointEntryStatus @default(PENDING)
  /// Optional external ref (e.g. journalId) for idempotent awards
  refId      String?
  expiresAt  DateTime?
  creditedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([memberId, status])
  @@index([memberId, event, status])
  @@index([memberId, event, refId])
  @@index([expiresAt])
  @@map("member_point_entries")
}

model MemberTrophy {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trophyId   String
  unlockedAt DateTime @default(now())

  @@unique([memberId, trophyId])
  @@index([memberId])
  @@map("member_trophies")
}

model MemberLoginToken {
  id        String    @id @default(uuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  shortCode String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, shortCode])
  @@index([expiresAt])
  @@map("member_login_tokens")
}

model PushSubscription {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("push_subscriptions")
}

/// Staff follow-up of a member (renewal, win-back, conversion, unpaid reminder).
model MemberOutreach {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// ABO_EXPIRING | ABO_ENDED | INACTIVE | CONVERT | UNPAID
  reason     String
  /// WHATSAPP | PUSH | CALL | SKIP
  channel    String
  message    String?
  /// Set when the contact belongs to a relance campaign (e.g. from an AI suggestion)
  campaignId String?
  createdAt  DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([createdAt])
  @@map("member_outreach")
}

model MemberGroup {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  maxMembers         Int          @default(15)
  discountForfait    Float        @default(0)
  discountAbonnement Float        @default(0)
  discountSalle      Float        @default(0)
  discountOpenSpace  Float        @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  members            Member[]

  @@index([organizationId])
  @@map("member_groups")
}

model Price {
  id                  String            @id @default(uuid())
  organizationId      String?
  organization        Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  price               Float
  type                PriceType
  category            PriceCategory?
  categories          PriceCategory[]   @default([])
  durationHours       Float?
  billingUnit         BillingUnit?
  periodDays          Int?
  spaceId             String?
  space               Space?            @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  occupySeat          Boolean           @default(true)
  occupyWhole         Boolean           @default(false)
  offerSpaces         PriceSpace[]
  reserveSeat         Boolean           @default(false)
  /// Hour 0-23 when dedicated seat starts (null = all day if reserveSeat)
  reserveSeatFromHour Int?
  /// Hour 0-23 when dedicated seat ends (null = all day)
  reserveSeatToHour   Int?
  isActive            Boolean           @default(true)
  /// Créneau tarif (happy hour): only sold when check-in hour is in [from, to) (to may exceed 24 = after midnight)
  availableFromHour   Int?
  availableToHour     Int?
  /// Weekdays the créneau applies (0 = dimanche … 6 = samedi); empty = every day
  availableDays       Int[]             @default([])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  timePeriod          Json
  abonnements         Abonnement[]
  journals            Journal[]
  visitRequests       VisitRequest[]
  appInstallPromos    AppInstallPromo[]
  promotions          Promotion[]
  history             PriceHistory[]

  @@index([organizationId])
  @@index([spaceId])
  @@index([isActive])
  @@map("prices")
}

/// Append-only catalog versions for BI / price-change analysis
model PriceHistory {
  id              String          @id @default(uuid())
  priceId         String
  priceRef        Price           @relation(fields: [priceId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  price           Float
  type            PriceType
  categories      PriceCategory[] @default([])
  billingUnit     BillingUnit?
  durationHours   Float?
  periodDays      Int?
  spaceId         String?
  isActive        Boolean         @default(true)
  changedAt       DateTime        @default(now())
  changedByUserId String?
  reason          String?

  @@index([priceId, changedAt])
  @@index([organizationId, changedAt])
  @@map("price_histories")
}

model PriceSpace {
  id      String @id @default(uuid())
  priceId String
  spaceId String
  price   Price  @relation(fields: [priceId], references: [id], onDelete: Cascade)
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([priceId, spaceId])
  @@index([spaceId])
  @@map("price_spaces")
}

model Journal {
  id                 String             @id @default(uuid())
  isPayed            Boolean
  registredTime      DateTime
  leaveTime          DateTime?
  payedAmount        Float
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt @db.Timestamp(6)
  memberID           String?
  isReservation      Boolean            @default(false)
  isAnonymous        Boolean            @default(false)
  guestName          String?
  priceId            String?
  /// Catalog name at sale time (stable for analytics)
  serviceName        String?
  /// Catalog list price at sale time
  listPrice          Float?
  /// Space used for this visit (snapshot)
  spaceId            String?
  spaceName          String?
  createdbyUserID    String?
  createdBy          User?              @relation(fields: [createdbyUserID], references: [id])
  members            Member?            @relation(fields: [memberID], references: [id])
  prices             Price?             @relation(fields: [priceId], references: [id])
  groupVisitId       String?
  /// AUTO = price follows pack tiers by elapsed time; FIXED = pack chosen (overtime rules apply)
  pricingMode        JournalPricingMode @default(FIXED)
  /// Original fixed tariff snapshot (kept even when overtime moves the price to the next tier)
  fixedPriceId       String?
  fixedServiceName   String?
  fixedDurationHours Float?
  /// Fixed tariff amount after discounts
  fixedAmount        Float?
  fixedAt            DateTime?
  /// Amount actually collected (payedAmount = amount owed)
  paidAmount         Float              @default(0)
  paidAt             DateTime?
  /// Amount owed when the visitor checked out unpaid; payedAmount is re-billed up to the late payment time
  amountAtCheckout   Float?
  /// Last pricing push sent (e.g. "warn:2", "tier:4") — dedupes cron notifications
  lastPricingNotice  String?
  /// Promo snapshot: amount before the promo, DT saved, label ("Promo app −10 %")
  priceBeforePromo   Float?
  promoDiscount      Float?
  promoLabel         String?
  /// Per check-in code (QR on the visitor session screen); not unique — lookups prefer today's open visit
  checkInCode        String             @default(dbgenerated("gen_checkin_code()"))
  /// Hidden by a staff member (delete in "hide" mode) — invisible to staff, waits for admin review
  hiddenAt           DateTime?
  hiddenByUserId     String?

  @@index([groupVisitId])
  @@index([priceId])
  @@index([spaceId])
  @@index([memberID, priceId])
  @@index([checkInCode])
  @@map("journals")
}

model Abonnement {
  id                  String              @id @default(uuid())
  isPayed             Boolean
  /// When the abonnement was fully paid — revenue is counted on this day (not the start date)
  paidAt              DateTime?
  registredDate       DateTime
  leaveDate           DateTime?
  stayedPeriode       String?
  payedAmount         Float
  createdAt           DateTime?           @default(now())
  updatedAt           DateTime?           @updatedAt @db.Timestamp(6)
  memberID            String
  isReservation       Boolean             @default(false)
  priceId             String
  /// Catalog name at sale time (stable for analytics)
  serviceName         String?
  /// Catalog list price at sale time
  listPrice           Float?
  /// Space reserved / used (snapshot; often same as reservedSeatSpaceId)
  spaceId             String?
  spaceName           String?
  /// Promo snapshot: amount before the promo, DT saved, label
  priceBeforePromo    Float?
  promoDiscount       Float?
  promoLabel          String?
  /// Member / group abonnement discount applied at sale time (%)
  discountPercent     Float?
  /// Price owed after discounts (payedAmount = collected so far)
  amountDue           Float?
  hoursQuota          Float?
  hoursUsed           Float               @default(0)
  reservedSeatLabel   String?
  reservedSeatSpaceId String?
  /// When to ask the client for payment (unpaid abonnements)
  paymentRemindAt     DateTime?
  /// Hidden by a staff member (delete in "hide" mode) — invisible to staff, waits for admin review
  hiddenAt            DateTime?
  hiddenByUserId      String?
  members             Member              @relation(fields: [memberID], references: [id])
  price               Price               @relation(fields: [priceId], references: [id])
  payments            AbonnementPayment[]

  @@index([priceId])
  @@index([spaceId])
  @@index([memberID, priceId])
  @@index([paidAt])
  @@map("abonnements")
}

/// Money collected for an abonnement (advance, remainder…) — revenue is counted on paidAt.
/// Sum of amounts = Abonnement.payedAmount.
model AbonnementPayment {
  id           String     @id @default(uuid())
  abonnementId String
  abonnement   Abonnement @relation(fields: [abonnementId], references: [id], onDelete: Cascade)
  amount       Float
  paidAt       DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([paidAt])
  @@index([abonnementId])
  @@map("abonnement_payments")
}

model Reservation {
  id            String    @id @default(uuid())
  isPayed       Boolean
  registredTime DateTime
  leaveTime     DateTime?
  payedAmount   Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @db.Timestamp(6)
  memberID      String?
  member        Member?   @relation(fields: [memberID], references: [id])

  @@map("reservations")
}

model Product {
  id             String         @id @default(uuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  purchasePrice  Float          @map("prix_achat")
  sellingPrice   Float          @map("prix_vente")
  stock          Int
  img            String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  dailyProducts  DailyProduct[]
  promotions     Promotion[]

  @@index([organizationId])
  @@map("products")
}

model DailyProduct {
  id            String             @id @default(uuid())
  productId     String
  date          DateTime?
  product       Product            @relation(fields: [productId], references: [id])
  quantite      Int
  externalOrgId String?
  externalRef   String?
  memberId      String?
  member        Member?            @relation(fields: [memberId], references: [id])
  journalId     String?
  status        ProductOrderStatus @default(CONFIRMED)
  isPayed       Boolean            @default(false)
  /// Price charged per unit (after promotion); null = product.sellingPrice
  unitPrice     Float?
  promotionId   String?
  syncedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Expense {
  id          String         @id @default(uuid())
  name        String
  description String?
  amount      Float          @map("prix")
  type        ExpenseType
  /// Recurring monthly charge: usual day of the month it is due
  dueDay      Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  logs        DailyExpense[]

  @@map("expenses")
}

/// One spent amount. Quick expenses have no template (amount + label only);
/// paid recurring charges link their template.
model DailyExpense {
  id            String       @id @default(uuid())
  expenseId     String?
  Summary       String?
  expense       Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  date          DateTime?
  /// Amount spent (null on legacy rows = template amount)
  amount        Float?
  /// Description (null on legacy rows = template name)
  label         String?
  kind          ExpenseType  @default(JOURNALIER)
  /// Where the money came from: CAISSE (cash drawer) | COFFRE | AUTRE (bank, card…)
  source        String       @default("CAISSE")
  coffreEntry   CoffreEntry?
  externalOrgId String?
  externalRef   String?
  syncedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([date])
}

enum JournalPricingMode {
  FIXED
  AUTO
}

enum MobileSeatMode {
  ADMIN_ASSIGN // admin picks seat on approve; visitor sees map
  VISITOR_CHOOSE // after approve, visitor picks seat on map
  AUTO_ASSIGN // auto free seat; auto-approve when receptionAway
}

/// How a space can be reserved (advance booking + forfait occupy).
enum SpaceReserveMode {
  SEAT /// one seat / place only
  WHOLE /// entire space only (e.g. salle de réunion)
  BOTH /// seat or entire space
}

model Organization {
  id             String                   @id @default(uuid())
  name           String
  slug           String                   @unique
  logo           String?
  facebookUrl    String?
  instagramUrl   String?
  isActive       Boolean                  @default(true)
  activatedAt    DateTime?                @default(now())
  notes          String?
  createdAt      DateTime                 @default(now())
  facilities     Facility[]
  members        Member[]
  memberGroups   MemberGroup[]
  products       Product[]
  prices         Price[]
  priceHistories PriceHistory[]
  memberships    OrganizationMembership[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(ORG_ADMIN)
  /// STAFF only: { journal: { read, write, delete: "none"|"hide"|"delete" }, reservations, impayes, abonnements }
  permissions    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model FacilityMembership {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Stub for Phase 3 fine-grained permissions
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, facilityId])
  @@index([facilityId])
  @@map("facility_memberships")
}

model Facility {
  id                          String               @id @default(uuid())
  name                        String
  numtel                      String
  email                       String
  adresse                     String
  logo                        String?
  nbrPlaces                   Int                  @map("nbr_places")
  socialNetworks              Json                 @map("social_networks")
  places                      Json                 @map("places") // legacy JSON; prefer Space/Table/Seat
  mobileSeatMode              MobileSeatMode       @default(ADMIN_ASSIGN)
  /// Visitor reservations: fee (DT), charged once or per place, paid at reception on the day
  reservationFee              Float                @default(2)
  reservationFeePerPlace      Boolean              @default(false)
  /// How far ahead a visitor can book, and how many places in one request
  reservationMaxDaysAhead     Int                  @default(14)
  reservationMaxPlaces        Int                  @default(4)
  /// Approve visitor reservations without reception
  reservationAutoApprove      Boolean              @default(false)
  receptionAway               Boolean              @default(false)
  receptionAwayStartedAt      DateTime?
  /// Global one-time promo for installing the app (DT or %)
  appInstallGlobalPromoActive Boolean              @default(false)
  appInstallGlobalPromoKind   PromoValueKind?
  appInstallGlobalPromoValue  Float?
  /// Tarif categories the global promo applies to (empty = all tarifs)
  appInstallGlobalPromoScopes PriceCategory[]      @default([])
  /// Session pricing: warn N minutes before a pack / tier ends
  sessionWarnBeforeMin        Int                  @default(5)
  /// AUTO sessions stay on the current tier N minutes after it ends
  autoTierGraceMin            Int                  @default(15)
  /// FIXED sessions: overtime without extra charge for N minutes
  fixedGraceMin               Int                  @default(15)
  /// FIXED sessions: extra (DT) once the grace is over
  overtimeSurchargeDt         Float                @default(0.75)
  /// FIXED sessions: switch to next tier price after N minutes over
  overtimeNextTierMin         Int                  @default(30)
  /// Opening hours used for occupancy; closeHour > 24 means after midnight (25 = 1h)
  openHour                    Int                  @default(8)
  closeHour                   Int                  @default(25)
  /// Open 24h/24 (special periods)
  alwaysOpen                  Boolean              @default(false)
  /// "Habitué" = at least N visit days per week
  regularVisitsPerWeek        Int                  @default(4)
  /// Alert when a regular has not come for N days
  inactiveAlertDays           Int                  @default(7)
  /// Google Maps review link shown to happy regulars
  googleReviewUrl             String?
  /// Ask for a review after N paid visits
  reviewAfterVisits           Int                  @default(5)
  /// Points for the sponsor and the friend after the friend's first paid visit
  referralPoints              Int                  @default(300)
  /// Free text for the AI advisor: neighbourhood, clientele, competitors, goals
  businessContext             String?
  /// Location for weather and neighbourhood lookups (AI advisor)
  latitude                    Float?
  longitude                   Float?
  organizationId              String?
  organization                Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  spaces                      Space[]
  events                      Event[]
  memberships                 FacilityMembership[]
  appInstallPromos            AppInstallPromo[]
  monthlyTargets              MonthlyTarget[]
  advisorReports              AdvisorReport[]
  initiatives                 BusinessInitiative[]
  advisorFacts                AdvisorFact[]
  advisorQuestions            AdvisorQuestion[]
  promotions                  Promotion[]
  shareLinks                  ShareLink[]
  outreachCampaigns           OutreachCampaign[]
  businessAnswers             BusinessAnswer[]
  featureProposals            FeatureProposal[]

  @@index([organizationId])
  @@map("facilities")
}

/// Monthly goals shown in Finance → Vue d'ensemble
model MonthlyTarget {
  id           String   @id @default(uuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  revenue      Float
  occupancyPct Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([facilityId, year, month])
  @@map("monthly_targets")
}

/// App-install promo linked to an abonnement tarif (max ~3 per facility)
model AppInstallPromo {
  id         String         @id @default(uuid())
  facilityId String
  facility   Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  priceId    String
  price      Price          @relation(fields: [priceId], references: [id], onDelete: Cascade)
  /// PERCENT (%) or FIXED_DT (dinars)
  valueKind  PromoValueKind
  value      Float
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([facilityId])
  @@index([priceId])
  @@map("app_install_promos")
}

model Space {
  id                 String           @id @default(uuid())
  facilityId         String
  facility           Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name               String
  category           PriceCategory?
  categories         PriceCategory[]  @default([])
  floorPlanUrl       String?
  sortOrder          Int              @default(0)
  capacityNormal     Int              @default(0)
  wifiSsid           String?
  wifiPassword       String?
  openForReservation Boolean          @default(false)
  reserveMode        SpaceReserveMode @default(BOTH)
  galleryUrls        String[]         @default([])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tables             Table[]
