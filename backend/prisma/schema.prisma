model CaisseSession {
  id            String           @id @default(uuid())
  date          DateTime         @db.Date
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  openingFloat  Float            @default(0)
  countedClose  Float?
  expectedClose Float?
  difference    Float?
  notes         String?
  /// Cash left in the drawer at closing (opening float of the next day)
  keptFloat     Float?
  externalOrgId String?
  externalRef   String?
