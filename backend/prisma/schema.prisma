model BookingRequest {
  id          String             @id @default(uuid())
  memberId    String
  member      Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind        BookingRequestKind
  spaceId     String?
  spaceName   String?
  seatLabel   String?
  /// Several places in one request (seatLabel = first one, kept for older clients)
  seatLabels  String[]           @default([])
  places      Int                @default(1)
