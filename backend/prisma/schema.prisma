generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  isActive           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt @db.Timestamp(6)
  deletedAt          DateTime? @db.Timestamp(6)
  email              String?   @unique @db.VarChar(256)
  fullname           String?   @db.VarChar(256)
  password           String?
  refreshToken       String?
  role               Role      @default(USER)
  resetPasswordToken String?
  accessToken        String?
  phoneNumber        String?   @unique
  Journals           Journal[]
  organizationMemberships OrganizationMembership[]
  facilityMemberships     FacilityMembership[]

  @@map("users")
}

model Member {
  id            String        @id @default(uuid())
  organizationId String
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email         String?       @db.VarChar(256)
  firstName     String?       @db.VarChar(56)
  lastName      String?       @db.VarChar(56)
  bio           String?
  avatarUrl     String?
  credits       Float         @default(0)
  plan          Subscription? @default(Journal)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt @db.Timestamp(6)
  deletedAt     DateTime?     @db.Timestamp(6)
  isActive      Boolean       @default(false)
  functionality String?
  phone         String?       @db.VarChar(32)
  passwordHash  String?
  pinHash       String?
  visitorNumber Int?
  userId        Int?
  groupId       String?
  group         MemberGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  discountForfait    Float?
  discountSalle      Float?
  discountOpenSpace  Float?
  abonnements   Abonnement[]
  journals      Journal[]
  reservations  Reservation[]
  seatBookings  SeatBooking[]
  visitRequests VisitRequest[]
  productOrders    DailyProduct[]
  sentMessages     CommunityMessage[] @relation("MessageFrom")
  receivedMessages CommunityMessage[] @relation("MessageTo")
  staffMessages    StaffMessage[]
  loginTokens      MemberLoginToken[]
  skills                 String[]  @default([])
  services               String[]  @default([])
  linkedinUrl            String?
  openToCollaboration    Boolean   @default(true)
  showInDirectory        Boolean   @default(true)
  eventRegistrations     EventRegistration[]
  pushSubscriptions      PushSubscription[]
  ledgerEntries          MemberLedger[]
  bookingRequests        BookingRequest[]

  @@unique([organizationId, phone])
  @@unique([organizationId, visitorNumber])
  @@index([organizationId])
  @@index([groupId])
  @@map("members")
}

model MemberLoginToken {
  id        String    @id @default(uuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  shortCode String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, shortCode])
  @@index([expiresAt])
  @@map("member_login_tokens")
}

model PushSubscription {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("push_subscriptions")
}

model MemberGroup {
  id                 String   @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  maxMembers         Int      @default(15)
  discountForfait    Float    @default(0)
  discountSalle      Float    @default(0)
  discountOpenSpace  Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  members            Member[]

  @@index([organizationId])
  @@map("member_groups")
}

model Price {
  id             String         @id @default(uuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  price          Float
  type           PriceType
  category       PriceCategory?
  durationHours  Float?
  billingUnit    BillingUnit?
  periodDays     Int?
  spaceId        String?
  space          Space?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  reserveSeat    Boolean        @default(false)
  /// Hour 0-23 when dedicated seat starts (null = all day if reserveSeat)
  reserveSeatFromHour Int?
  /// Hour 0-23 when dedicated seat ends (null = all day)
  reserveSeatToHour   Int?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  timePeriod     Json
  abonnements    Abonnement[]
  journals       Journal[]
  visitRequests  VisitRequest[]

  @@index([organizationId])
  @@index([spaceId])
  @@index([isActive])
  @@map("prices")
}

model Journal {
  id              String    @id @default(uuid())
  isPayed         Boolean
  registredTime   DateTime
  leaveTime       DateTime?
  payedAmount     Float
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @db.Timestamp(6)
  memberID        String?
  isReservation   Boolean   @default(false)
  isAnonymous     Boolean   @default(false)
  guestName       String?
  priceId         String?
  createdbyUserID String?
  createdBy       User?     @relation(fields: [createdbyUserID], references: [id])
  members         Member?   @relation(fields: [memberID], references: [id])
  prices          Price?    @relation(fields: [priceId], references: [id])
  groupVisitId    String?

  @@index([groupVisitId])
  @@map("journals")
}

model Abonnement {
  id            String    @id @default(uuid())
  isPayed       Boolean
  registredDate DateTime
  leaveDate     DateTime?
  stayedPeriode String?
  payedAmount   Float
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt @db.Timestamp(6)
  memberID      String
  isReservation Boolean   @default(false)
  priceId       String
  hoursQuota         Float?
  hoursUsed          Float     @default(0)
  reservedSeatLabel  String?
  reservedSeatSpaceId String?
  members            Member    @relation(fields: [memberID], references: [id])
  price              Price     @relation(fields: [priceId], references: [id])

  @@map("abonnements")
}

model Reservation {
  id            String    @id @default(uuid())
  isPayed       Boolean
  registredTime DateTime
  leaveTime     DateTime?
  payedAmount   Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @db.Timestamp(6)
  memberID      String?
  member        Member?   @relation(fields: [memberID], references: [id])

  @@map("reservations")
}

model Product {
  id            String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  purchasePrice Float    @map("prix_achat")
  sellingPrice  Float    @map("prix_vente")
  stock         Int
  img           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  dailyProducts DailyProduct[]

  @@index([organizationId])
  @@map("products")
}
model DailyProduct {
  id            String             @id @default(uuid())
  productId     String
  date          DateTime?
  product       Product            @relation(fields: [productId], references: [id])
  quantite      Int
  externalOrgId String?
  externalRef   String?
  memberId      String?
  member        Member?            @relation(fields: [memberId], references: [id])
  journalId     String?
  status        ProductOrderStatus @default(CONFIRMED)
  isPayed       Boolean            @default(false)
  syncedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Expense {
  id          String         @id @default(uuid())
  name        String
  description String?
  amount      Float          @map("prix")
  type        ExpenseType
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  logs        DailyExpense[]

  @@map("expenses")
}

model DailyExpense {
  id            String    @id @default(uuid())
  expenseId     String
  Summary       String?
  expense       Expense   @relation(fields: [expenseId], references: [id])
  date          DateTime?
  externalOrgId String?
  externalRef   String?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum MobileSeatMode {
  ADMIN_ASSIGN // admin picks seat on approve; visitor sees map
  VISITOR_CHOOSE // after approve, visitor picks seat on map
  AUTO_ASSIGN // auto free seat; auto-approve when receptionAway
}

model Organization {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  logo          String?
  facebookUrl   String?
  instagramUrl  String?
  isActive      Boolean    @default(true)
  activatedAt   DateTime?  @default(now())
  notes         String?
  createdAt     DateTime   @default(now())
  facilities    Facility[]
  members       Member[]
  memberGroups  MemberGroup[]
  products      Product[]
  prices        Price[]
  memberships   OrganizationMembership[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role     @default(ORG_ADMIN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model FacilityMembership {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Stub for Phase 3 fine-grained permissions
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, facilityId])
  @@index([facilityId])
  @@map("facility_memberships")
}

model Facility {
  id             String         @id @default(uuid())
  name           String
  numtel         String
  email          String
  adresse        String
  logo           String?
  nbrPlaces      Int            @map("nbr_places")
  socialNetworks Json           @map("social_networks")
  places         Json           @map("places") // legacy JSON; prefer Space/Table/Seat
  mobileSeatMode MobileSeatMode @default(ADMIN_ASSIGN)
  receptionAway  Boolean        @default(false)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  spaces         Space[]
  events         Event[]
  memberships    FacilityMembership[]

  @@index([organizationId])
  @@map("facilities")
}

model Space {
  id             String          @id @default(uuid())
  facilityId     String
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name           String
  category       PriceCategory?
  floorPlanUrl   String?
  sortOrder      Int             @default(0)
  capacityNormal Int             @default(0)
  wifiSsid       String?
  wifiPassword   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tables         Table[]
  seats          Seat[]
  walls          SpaceWall[]
  fixtures       SpaceFixture[]
  bookings       SeatBooking[]
  prices         Price[]

  @@map("spaces")
}

model SpaceWall {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  label     String?
  x         Float    @default(40)
  y         Float    @default(40)
  width     Float    @default(160)
  height    Float    @default(12)
  rotation  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("space_walls")
}

enum FixtureKind {
  ARMCHAIR
  TV
  TRIANGLE
  CIRCLE
  DOOR
  TOILET
  KITCHEN
}

model SpaceFixture {
  id        String      @id @default(uuid())
  spaceId   String
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind      FixtureKind
  label     String?
  x         Float       @default(40)
  y         Float       @default(40)
  width     Float       @default(48)
  height    Float       @default(48)
  rotation  Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([spaceId])
  @@map("space_fixtures")
}

model Table {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String?
  x         Float    @default(40)
  y         Float    @default(40)
  width     Float    @default(120)
  height    Float    @default(80)
  rotation  Float    @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seats     Seat[]

  @@map("tables")
}

model Seat {
  id         String  @id @default(uuid())
  spaceId    String
  space      Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tableId    String?
  table      Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  label      String // stable id for SeatBooking.seatId
  offsetX    Float   @default(0)
  offsetY    Float   @default(0)
  isOverflow Boolean @default(false)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([spaceId, label])
  @@map("seats")
}

model SeatBooking {
  id        String    @id @default(uuid())
  eventKey  String
  seatId    String
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  isBooked    Boolean   @default(false)
  isPermanent Boolean   @default(false)
  bookedAt    DateTime?
  memberId    String?
  member    Member?   @relation(fields: [memberId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([eventKey, spaceId, seatId])
  @@index([spaceId])
  @@map("seat_bookings")
}

model OpsEvent {
  id         String   @id @default(uuid())
  type       String
  occurredAt DateTime @default(now())
  memberId   String?
  seatId     String?
  journalId  String?
  amount     Float?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([type, occurredAt])
  @@index([occurredAt])
  @@map("ops_events")
}

model CaisseSession {
  id            String           @id @default(uuid())
  date          DateTime         @db.Date
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  openingFloat  Float            @default(0)
  countedClose  Float?
  expectedClose Float?
  difference    Float?
  notes         String?
  externalOrgId String?
  externalRef   String?
  syncedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  movements     CaisseMovement[]
  coffreEntries CoffreEntry[]

  @@unique([date])
  @@map("caisse_sessions")
}

model CoffreEntry {
  id              String         @id @default(uuid())
  date            DateTime       @db.Date
  type            String // IN | OUT
  amount          Float
  label           String?
  caisseSessionId String?
  caisseSession   CaisseSession? @relation(fields: [caisseSessionId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([date])
  @@map("coffre_entries")
}

model CaisseMovement {
  id               String        @id @default(uuid())
  sessionId        String
  session          CaisseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type             String // IN | OUT
  amount           Float
  label            String?
  externalOrgId    String?
  externalRef      String?
  syncedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("caisse_movements")
}

model VisitRequest {
  id        String             @id @default(uuid())
  memberId  String
  priceId   String
  type      VisitRequestType
  status    VisitRequestStatus @default(PENDING)
  member    Member             @relation(fields: [memberId], references: [id])
  price     Price              @relation(fields: [priceId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("visit_requests")
}

model CommunityMessage {
  id           String   @id @default(uuid())
  fromMemberId String
  toMemberId   String
  text         String
  fromMember   Member   @relation("MessageFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember     Member   @relation("MessageTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([toMemberId, createdAt])
  @@index([fromMemberId, createdAt])
  @@map("community_messages")
}

model StaffMessage {
  id         String                @id @default(uuid())
  toMemberId String
  toMember   Member                @relation(fields: [toMemberId], references: [id], onDelete: Cascade)
  fromUserId String?
  direction  StaffMessageDirection @default(TO_MEMBER)
  text       String
  readAt     DateTime?
  createdAt  DateTime              @default(now())

  @@index([toMemberId, createdAt])
  @@index([direction, readAt])
  @@map("staff_messages")
}

enum StaffMessageDirection {
  TO_MEMBER
  TO_STAFF
}

enum LedgerKind {
  CREDIT
  ECHEANCE
}

model MemberLedger {
  id           String     @id @default(uuid())
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind         LedgerKind
  amount       Float
  note         String?
  dueDate      DateTime?
  source       String?
  journalId    String?
  abonnementId String?
  settled      Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([memberId, createdAt])
  @@index([kind, settled])
  @@map("member_ledger")
}

enum BookingRequestKind {
  ROOM
  SEAT
}

model BookingRequest {
  id             String             @id @default(uuid())
  memberId       String
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind           BookingRequestKind
  spaceId        String?
  spaceName      String?
  seatLabel      String?
  seatSpaceId    String?
  date           DateTime
  startAt        DateTime
  endAt          DateTime
  note           String?
  status         VisitRequestStatus @default(PENDING)
  journalId      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([memberId])
  @@map("booking_requests")
}

enum VisitRequestType {
  DAY
  SUBSCRIPTION
}

enum VisitRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseType {
  MENSUEL
  JOURNALIER
}

enum PriceType {
  journal
  abonnement
}

enum PriceCategory {
  JOURNEE
  ABONNEMENT
  SALLE
  OPEN_SPACE
}

enum BillingUnit {
  PACK
  HOURLY
  PERIOD
}

enum ProductOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  FACILITY_ADMIN
  ADMIN
  USER
}

enum EventKind {
  WORKSHOP
  NETWORKING
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  NO_SHOW
}

model Event {
  id           String              @id @default(uuid())
  facilityId   String
  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  kind         EventKind           @default(OTHER)
  location     String?
  startAt      DateTime
  endAt        DateTime
  capacity     Int?
  status       EventStatus         @default(DRAFT)
  coverImage   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  registrations EventRegistration[]

  @@index([facilityId, startAt])
  @@index([status, startAt])
  @@map("events")
}

model EventRegistration {
  id               String                   @id @default(uuid())
  eventId          String
  event            Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status           EventRegistrationStatus  @default(REGISTERED)
  attendanceCode   String                   @unique
  checkedInAt      DateTime?
  feedbackRating   Int?
  feedbackComment  String?
  feedbackAt       DateTime?
  createdAt        DateTime                 @default(now())

  @@unique([eventId, memberId])
  @@index([eventId, status])
  @@map("event_registrations")
}

enum Subscription {
  Journal
  Membership
}