# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/coadmin"

# --- Server ---
PORT=4000
GLOBAL_PREFIX=api

# --- Auth (JWT) ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# --- Mailer (welcome / reset-password / verify-email) ---
MAILER_HOST="smtp.example.com"
MAILER_PORT=587
MAILER_USER="no-reply@example.com"
MAILER_PASSWORD="replace-with-smtp-password"
MAILER_FROM="no-reply@example.com"

# --- Web push notifications ---
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# --- AI advisor module (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-replace-with-real-key"
ANTHROPIC_WORKSPACE_ID="replace-with-workspace-id"
ANTHROPIC_AUTH_TOKEN="replace-if-used-instead-of-api-key"
ADVISOR_MODEL="claude-sonnet-5"
ADVISOR_WEEKLY="true"

# --- ERP sync bridge: existing day-close aggregate push (caisse.service.ts) ---
ERP_SYNC_ENABLED="false"
ERP_API_URL="https://your-supply-chain-pro-instance.example.com"
ERP_ORG_ID="replace-with-target-organization-id"

# --- ERP sync bridge: granular sync (src/modules/erp-sync) ---
# The login co-admin uses to authenticate against supply-chain-pro's own API.
# Must be an existing user account in supply-chain-pro that belongs to the
# target organization above — there is no separate API key mechanism.
ERP_EMAIL="bridge-user@example.com"
ERP_PASSWORD="replace-with-that-account-password"
